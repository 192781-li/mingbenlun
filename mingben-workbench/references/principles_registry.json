      "keywords": ["先证弱版"]
    },
    {
      "id": "M04",
      "principle": "PTC公理0-6是操作范畴论基础",
      "must_contain_in": ["mingben-workbench/references/formalization-v0.2.md"],
      "keywords": ["公理0", "公理1", "公理2", "公理3", "公理4", "公理5", "公理6"]
    },
    {
      "id": "M05",
      "principle": "T001: !(νF)≇ν(!F) 生命不可资本化",
      "must_contain_in": ["mingben-workbench/references/theorem_registry.json"],
      "keywords": ["生命不可资本化"]
    },
    {
      "id": "M06",
      "principle": "T002: S_A ⊬ Ag_lv 自由只能在实践中确立",
      "must_contain_in": ["mingben-workbench/references/theorem_registry.json"],
      "keywords": ["自由只能在实践中确立"]
    },
    {
      "id": "M07",
      "principle": "方向可能比格罗滕迪克更根本，但成就是0。L8是武器库不是胜仗。L8之后用ALL解决重大开放问题、被别人使用，才有资格比较。之前不许声称超越。",
      "check_type": "informational"
    },
    {
      "id": "M08",
      "principle": "阳主阴从：野心不设上限，证明必须过硬。路线图/验证/层级是阴（工具），野性直觉/创造力/敢想敢干是阳（主人）。阴为阳服务，不压制阳。地基必须硬，但地基之上长什么不设限。",
      "check_type": "informational"
    }
  ],
  "user_directives": [
