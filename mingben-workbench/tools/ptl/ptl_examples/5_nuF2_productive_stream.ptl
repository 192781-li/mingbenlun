;; ============================================================
;; 示例5：νF2生产性流——永远运行，每步必须产出
;; ============================================================

;; 自然数流：state=n，产出n，下一步state=n+1
(let nats
  (stream n 0                    ;; 状态n，初始0
    (pair (+ n 1) n))             ;; (新状态n+1, 产出n)——生产性！
  (take nats 10))                 ;; 取前10个产出

;; 结果: (10, 9) — 取了10步，最后产出9
;; 编译器保证：每步都有产出，不能空转
;; 如果写成 (stream n 0 (pair n n)) 状态不更新也可以（恒定流）
;; 但如果step不直接产出pair，编译不通过（非生产性）
