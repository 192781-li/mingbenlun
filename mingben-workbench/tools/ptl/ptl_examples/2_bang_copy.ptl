;; ============================================================
;; 示例2：!-模态值可以复制，线性值不能
;; ============================================================

;; 配置文件是!-模态的（死数据），可以复制
(let config (bang 100)
  (dup config
    (+ config config)))          ;; ✅ !-模态值可以复制

;; 运行中的过程是线性的，不能复制
;; (let process (lin (lam (x Int) x))
;;   (dup process                ;; ❌ 编译错误：线性值不能复制
;;     0))
