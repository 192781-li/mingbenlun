;; ============================================================
;; 示例1：线性资源——文件句柄必须用恰好一次
;; ============================================================

;; 旧语言：文件句柄可以忘记关（泄漏）或关两次（崩溃）
;; PTL：编译器强制线性使用

(let handle (lin 42)           ;; 打开一个"文件"（线性资源）
  (+ handle 1))                 ;; 必须使用，用完自动释放

;; 如果写成下面这样，编译不通过：
;; (let handle (lin 42)
;;   0)                         ;; ❌ 线性资源被丢弃！
;; (let handle (lin 42)
;;   (+ handle handle))         ;; ❌ 线性资源被使用两次！
