;; ============================================================
;; 示例8：GoI迹——反馈回路原生支持
;; ============================================================

;; 斐波那契流：每步产出下一个斐波那契数
(let fib
  (stream pair_nm (pair 0 1)        ;; 状态=(n, m)，初始(0,1)
    (pair (pair (+ 0 1) 0) 0))      ;; 简化版
  (take fib 5))

;; 更实际的例子：反馈控制系统
;; 旧语言需要用观察者模式/事件循环/消息队列
;; PTL：stream就是反馈回路，take就是运行
