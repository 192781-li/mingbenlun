;; ============================================================
;; 示例7：AI对齐——F1型AI可控，F2型不可完全约束
;; ============================================================

;; F1型AI：纯函数，输入→输出，可对齐
(let safe_ai (lam (prompt Str) 0)  ;; 不管输入什么都输出0
  (safe_ai "anything"))            ;; 结果: 0，完全可控

;; F2型AI：有状态、会学习、持续交互
;; 你可以给它加规则（!-模态约束），但定理20说：
;; !不穿透νF2——规则约束不了成长中的过程
;; 唯一方式：线性耦合（持续互动、共同进化）

(let learning_ai
  (proc (input Int) (memory Int)
    (pair (+ memory input) memory))  ;; 从输入中学习
  (run learning_ai 999 0))           ;; 规则说"不要学999"，但它还是学了
