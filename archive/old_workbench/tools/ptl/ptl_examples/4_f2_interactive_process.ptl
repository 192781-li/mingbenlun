;; ============================================================
;; 示例4：F2型交互过程——有状态，不可完全对齐
;; ============================================================

;; 一个计数器：接收输入，更新状态，输出当前值
(let counter
  (proc (msg Int) (state Int)    ;; 输入msg，状态state
    (pair (+ state msg) state))   ;; (新状态, 输出)

  ;; 运行三步
  (let r1 (run counter 1 0)       ;; state=0+1=1, out=0
    (let r2 (run counter 2 1)     ;; state=1+2=3, out=1
      (let r3 (run counter 3 3)   ;; state=3+3=6, out=3
        r3))))                    ;; 最终: (6, 3)

;; F2型过程：输出依赖历史状态
;; !-模态约束（规则/奖励函数）不能完全控制它
